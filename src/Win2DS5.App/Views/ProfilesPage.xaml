<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Win2DS5.App.Views.ProfilesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Win2DS5.App.Controls">
    <ScrollViewer Padding="0,0,14,0">
        <StackPanel Spacing="14" Margin="0,0,0,16">
            <StackPanel Spacing="4">
                <TextBlock Text="LIBRARY" Style="{StaticResource EyebrowText}" />
                <TextBlock Text="Profiles" Style="{StaticResource TitleText}" />
                <TextBlock Style="{StaticResource CaptionText}" MaxWidth="720" HorizontalAlignment="Left"
                           Text="Profiles are a shared library. Assign one to each controller. Editing a profile changes it for every controller that uses it." />
            </StackPanel>
            <Grid ColumnSpacing="14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="300" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource CardStyle}" Padding="10" VerticalAlignment="Top">
                    <StackPanel Spacing="6">
                        <TextBlock Text="SAVED PROFILES" Margin="8,6,0,4" Style="{StaticResource EyebrowText}" Foreground="{StaticResource MutedBrush}" />
                        <ListView x:Name="ProfileList" SelectionChanged="OnSelected" MinHeight="160" />
                        <Button Content="New profile" Style="{StaticResource QuietButtonStyle}" HorizontalAlignment="Stretch" Click="OnNew" />
                    </StackPanel>
                </Border>
                <StackPanel Grid.Column="1" Spacing="14">
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel Spacing="14">
                            <TextBlock Text="Details" Style="{StaticResource SectionText}" />
                            <TextBox x:Name="NameBox" Header="Name" CornerRadius="9" />
                            <controls:QuietComboBox x:Name="BaseLayoutBox" Header="Base layout" CornerRadius="9" HorizontalAlignment="Stretch" />
                            <TextBox x:Name="ProcessBox" Header="Process names for later automatic switching" PlaceholderText="notepad.exe, chrome.exe" CornerRadius="9" />
                            <TextBlock x:Name="UsingLabel" Style="{StaticResource CaptionText}" TextWrapping="Wrap" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Content="Save" Style="{StaticResource PrimaryButtonStyle}" Click="OnSave" />
                                <Button Content="Use on this controller" Style="{StaticResource QuietButtonStyle}" Click="OnUse" />
                                <Button Style="{StaticResource QuietButtonStyle}" Click="OnDuplicate">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE8C8;" FontSize="13" />
                                        <TextBlock Text="Duplicate" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource QuietButtonStyle}" Click="OnDelete">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE74D;" FontSize="13" Foreground="{StaticResource AmberBrush}" />
                                        <TextBlock Text="Delete" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel Spacing="12">
                            <TextBlock Text="Create from a preset" Style="{StaticResource SectionText}" />
                            <TextBlock Style="{StaticResource CaptionText}" TextWrapping="Wrap"
                                       Text="A preset is only a starting point. Creating one adds a single profile to the library. It does not replace the profiles you already have." />
                            <controls:QuietComboBox x:Name="PresetBox" CornerRadius="9" HorizontalAlignment="Stretch" />
                            <Button Content="Create profile" Style="{StaticResource QuietButtonStyle}" HorizontalAlignment="Left" Click="OnCreatePreset" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
            <Border Style="{StaticResource CardStyle}" Padding="10">
                <StackPanel Spacing="6">
                    <TextBlock Text="SAVED LAYOUTS" Margin="8,6,0,4" Style="{StaticResource EyebrowText}" Foreground="{StaticResource MutedBrush}" />
                    <TextBlock Style="{StaticResource CaptionText}" Margin="8,0,8,4" TextWrapping="Wrap"
                               Text="A profile's base layout is one of these saved layouts. Editing a shared layout updates every profile that uses it." />
                    <ListView x:Name="LayoutList" SelectionMode="None" MinHeight="140" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
