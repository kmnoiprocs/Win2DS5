<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Win2DS5.App.Views.ProfilesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer Padding="0,0,14,0">
        <StackPanel Spacing="14" Margin="0,0,0,16">
            <StackPanel Spacing="4">
                <TextBlock Text="LIBRARY" Style="{StaticResource EyebrowText}" />
                <TextBlock Text="Profiles" Style="{StaticResource TitleText}" />
            </StackPanel>
            <Grid ColumnSpacing="14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="300" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource CardStyle}" Padding="10" VerticalAlignment="Top">
                    <StackPanel Spacing="6">
                        <TextBlock Text="YOUR PROFILES" Margin="8,6,0,4" Style="{StaticResource EyebrowText}" Foreground="{StaticResource MutedBrush}" />
                        <ListView x:Name="ProfileList" SelectionChanged="OnSelected" MinHeight="120" />
                    </StackPanel>
                </Border>
                <StackPanel Grid.Column="1" Spacing="14">
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel Spacing="14">
                            <TextBlock Text="Details" Style="{StaticResource SectionText}" />
                            <TextBox x:Name="NameBox" Header="Name" CornerRadius="9" />
                            <TextBox x:Name="ProcessBox" Header="Process names for later automatic switching" PlaceholderText="notepad.exe, chrome.exe" CornerRadius="9" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Content="Save details" Style="{StaticResource PrimaryButtonStyle}" Click="OnSave" />
                                <Button Style="{StaticResource QuietButtonStyle}" Click="OnDuplicate">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE8C8;" FontSize="13" />
                                        <TextBlock Text="Duplicate" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource QuietButtonStyle}" Click="OnDelete">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE74D;" FontSize="13" Foreground="{StaticResource AmberBrush}" />
                                        <TextBlock Text="Delete" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel Spacing="12">
                            <TextBlock Text="Start from a preset" Style="{StaticResource SectionText}" />
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button Style="{StaticResource QuietButtonStyle}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="16,14" Click="OnMouseHand">
                                    <StackPanel Spacing="6">
                                        <FontIcon Glyph="&#xE962;" FontSize="18" HorizontalAlignment="Left" Foreground="{StaticResource AccentTextBrush}" />
                                        <TextBlock Text="Mouse hand" FontWeight="SemiBold" />
                                        <TextBlock Style="{StaticResource CaptionText}" Text="Triggers click, R1 holds a shift layer, L1 slows the pointer." />
                                    </StackPanel>
                                </Button>
                                <Button Grid.Column="1" Style="{StaticResource QuietButtonStyle}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="16,14" Click="OnTriggerShift">
                                    <StackPanel Spacing="6">
                                        <FontIcon Glyph="&#xE8AB;" FontSize="18" HorizontalAlignment="Left" Foreground="{StaticResource AccentTextBrush}" />
                                        <TextBlock Text="Trigger shift" FontWeight="SemiBold" />
                                        <TextBlock Style="{StaticResource CaptionText}" Text="A quick R2 is a left click. Holding R2 switches to a shift layer." />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
