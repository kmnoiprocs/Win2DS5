<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Win2DS5.App.Views.ControlsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Win2DS5.App.Controls">
    <Grid RowSpacing="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="8">
                <TextBlock Text="LAYERS" Style="{StaticResource EyebrowText}" />
                <StackPanel x:Name="LayerTabs" Orientation="Horizontal" Spacing="6" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Bottom">
                <TextBox x:Name="LayerName" Width="150" PlaceholderText="New layer name" CornerRadius="9" />
                <Button Style="{StaticResource PrimaryButtonStyle}" Click="OnAddLayer">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE710;" FontSize="12" />
                        <TextBlock Text="Add layer" Foreground="{StaticResource AccentInkBrush}" FontWeight="SemiBold" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>
        <Grid Grid.Row="1" ColumnSpacing="14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="372" />
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource CardStyle}" Padding="0">
                <Grid>
                    <Border CornerRadius="14" Background="{StaticResource CanvasGradientBrush}" Opacity="0.55" />
                    <controls:ControllerDiagram x:Name="Diagram" Margin="20,44,20,56" />
                    <StackPanel Margin="20,16,20,0" VerticalAlignment="Top" Orientation="Horizontal" Spacing="10">
                        <Border Style="{StaticResource ChipStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Ellipse x:Name="LayerDot" Width="7" Height="7" Fill="{StaticResource AccentBrush}" VerticalAlignment="Center" />
                                <TextBlock x:Name="LayerState" FontSize="12" Foreground="{StaticResource AccentTextBrush}" FontWeight="SemiBold" />
                            </StackPanel>
                        </Border>
                        <TextBlock x:Name="EditingState" FontSize="12" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                    <Border x:Name="HoverCard" Margin="0,0,0,16" VerticalAlignment="Bottom" HorizontalAlignment="Center"
                            Background="{StaticResource PanelAltBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                            CornerRadius="12" Padding="14,8" Opacity="0">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock x:Name="HoverName" FontWeight="SemiBold" FontSize="13" />
                            <Rectangle Width="1" Height="14" Fill="{StaticResource LineBrush}" VerticalAlignment="Center" />
                            <TextBlock x:Name="HoverBinding" FontSize="13" Foreground="{StaticResource AccentTextBrush}" />
                        </StackPanel>
                    </Border>
                    <TextBlock x:Name="HintText" Margin="0,0,0,24" VerticalAlignment="Bottom" HorizontalAlignment="Center"
                               Style="{StaticResource CaptionText}" Text="Click any control to edit it. Press buttons on the controller to see them light up." />
                </Grid>
            </Border>
            <Border Grid.Column="1" Style="{StaticResource CardStyle}" Padding="0">
                <controls:BindingPanel x:Name="Editor" />
            </Border>
        </Grid>
    </Grid>
</UserControl>
