<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Win2DS5.App.Views.ControlsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Win2DS5.App.Controls">
    <Grid ColumnSpacing="14">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="460" />
            <ColumnDefinition Width="430" />
        </Grid.ColumnDefinitions>

        <Border Style="{StaticResource CardStyle}" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel Padding="18,16,18,0" Spacing="2">
                    <TextBlock Text="CONTROLLER" Style="{StaticResource EyebrowText}" />
                    <TextBlock x:Name="ControllerTitle" FontFamily="{StaticResource DisplayFont}" FontSize="22" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Padding="18,10,18,0">
                    <Border Background="{StaticResource PanelAltBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                            CornerRadius="12" Padding="3" HorizontalAlignment="Left">
                        <StackPanel x:Name="ControllerTabs" Orientation="Horizontal" Spacing="2" />
                    </Border>
                </ScrollViewer>
                <StackPanel Grid.Row="2" Padding="18,10,18,0" Spacing="12">
                    <StackPanel Spacing="6">
                    <TextBlock Text="PROFILE" Style="{StaticResource EyebrowText}" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Grid Width="196" Height="34" VerticalAlignment="Center">
                            <Button x:Name="ProfileButton" Height="34" MinHeight="0" VerticalAlignment="Stretch"
                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" VerticalContentAlignment="Center"
                                    Style="{StaticResource QuietButtonStyle}" Click="OnProfileMenu" CornerRadius="10" Padding="12,0">
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <TextBlock x:Name="ProfileLabel" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="140" />
                                    <FontIcon Glyph="&#xE70D;" FontSize="10" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <TextBox x:Name="ProfileNameBox" Visibility="Collapsed" Height="34" MinHeight="0" VerticalAlignment="Stretch"
                                     VerticalContentAlignment="Center" CornerRadius="10" Padding="12,0"
                                     KeyDown="OnProfileNameKey" LostFocus="OnProfileNameLost" />
                        </Grid>
                        <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                            <Button x:Name="SaveProfileButton" Width="34" Height="34" Padding="0" CornerRadius="10"
                                    Style="{StaticResource GhostButtonStyle}" Click="OnSaveProfile" ToolTipService.ToolTip="Save profile">
                                <FontIcon Glyph="&#xE74E;" FontSize="14" />
                            </Button>
                            <Button x:Name="RenameProfileButton" Width="34" Height="34" Padding="0" CornerRadius="10"
                                    Style="{StaticResource GhostButtonStyle}" Click="OnRenameProfile" ToolTipService.ToolTip="Rename profile">
                                <FontIcon Glyph="&#xE70F;" FontSize="14" />
                            </Button>
                            <Button x:Name="DeleteProfileButton" Width="34" Height="34" Padding="0" CornerRadius="10"
                                    Style="{StaticResource GhostButtonStyle}" Click="OnDeleteProfile" ToolTipService.ToolTip="Delete profile">
                                <FontIcon Glyph="&#xE74D;" FontSize="14" />
                            </Button>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="ProfileColorButton" Width="34" Height="34" Padding="0" CornerRadius="10"
                                Style="{StaticResource GhostButtonStyle}" ToolTipService.ToolTip="Shell color">
                            <Ellipse x:Name="ProfileSwatch" Width="16" Height="16" Fill="{StaticResource PadShellBrush}" Stroke="{StaticResource LineBrush}" StrokeThickness="1" />
                            <Button.Flyout>
                                <Flyout Opened="OnProfileColorOpened" Closed="OnProfileColorClosed">
                                    <StackPanel Spacing="10" Width="280">
                                        <ColorPicker x:Name="ProfileColorPicker" IsAlphaEnabled="False" IsMoreButtonVisible="False"
                                                     IsColorChannelTextInputVisible="False" ColorChanged="OnProfileColorChanged" />
                                        <Button Content="Use the standard shell" Style="{StaticResource QuietButtonStyle}" Click="OnProfileColorDefault" />
                                    </StackPanel>
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                        <Button Width="34" Height="34" Padding="0" CornerRadius="10"
                                Style="{StaticResource GhostButtonStyle}" Click="OnProfileImage" ToolTipService.ToolTip="Shell image">
                            <FontIcon Glyph="&#xE91B;" FontSize="14" />
                        </Button>
                        <Button x:Name="ProfileShellClear" Width="34" Height="34" Padding="0" CornerRadius="10"
                                Style="{StaticResource GhostButtonStyle}" Click="OnClearShell" ToolTipService.ToolTip="Clear shell">
                            <FontIcon Glyph="&#xE711;" FontSize="12" />
                        </Button>
                    </StackPanel>
                    </StackPanel>
                    <StackPanel Spacing="6">
                        <TextBlock Text="LAYOUT" Style="{StaticResource EyebrowText}" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Grid Width="196" Height="34" VerticalAlignment="Center">
                                <Button x:Name="LayoutButton" Height="34" MinHeight="0" VerticalAlignment="Stretch"
                                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" VerticalContentAlignment="Center"
                                        Style="{StaticResource QuietButtonStyle}" Click="OnLayoutMenu" CornerRadius="10" Padding="12,0">
                                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <TextBlock x:Name="LayoutLabel" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="140" />
                                        <FontIcon Glyph="&#xE70D;" FontSize="10" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <TextBox x:Name="LayoutNameBox" Visibility="Collapsed" Height="34" MinHeight="0" VerticalAlignment="Stretch"
                                         VerticalContentAlignment="Center" CornerRadius="10" Padding="12,0"
                                         KeyDown="OnLayoutNameKey" LostFocus="OnLayoutNameLost" />
                            </Grid>
                            <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                                <Button x:Name="LayoutColorButton" Width="34" Height="34" Padding="0" CornerRadius="10"
                                        Style="{StaticResource GhostButtonStyle}" ToolTipService.ToolTip="Lightbar color">
                                    <Ellipse x:Name="LayoutSwatch" Width="16" Height="16" Fill="{StaticResource AccentBrush}" Stroke="{StaticResource LineBrush}" StrokeThickness="1" />
                                    <Button.Flyout>
                                        <Flyout Opened="OnLayoutColorOpened" Closed="OnLayoutColorClosed">
                                            <StackPanel Spacing="10" Width="280">
                                                <ColorPicker x:Name="LayoutColorPicker" IsAlphaEnabled="False" IsMoreButtonVisible="False"
                                                             IsColorChannelTextInputVisible="False" ColorChanged="OnLayoutColorChanged" />
                                                <Button Content="Use the accent color" Style="{StaticResource QuietButtonStyle}" Click="OnLayoutColorDefault" />
                                            </StackPanel>
                                        </Flyout>
                                    </Button.Flyout>
                                </Button>
                                <Button Width="34" Height="34" Padding="0" CornerRadius="10"
                                        Style="{StaticResource GhostButtonStyle}" Click="OnSaveLayout" ToolTipService.ToolTip="Save layout">
                                    <FontIcon Glyph="&#xE74E;" FontSize="14" />
                                </Button>
                                <Button Width="34" Height="34" Padding="0" CornerRadius="10"
                                        Style="{StaticResource GhostButtonStyle}" Click="OnRenameLayout" ToolTipService.ToolTip="Rename layout">
                                    <FontIcon Glyph="&#xE70F;" FontSize="14" />
                                </Button>
                                <Button Width="34" Height="34" Padding="0" CornerRadius="10"
                                        Style="{StaticResource GhostButtonStyle}" Click="OnDeleteLayout" ToolTipService.ToolTip="Delete layout">
                                    <FontIcon Glyph="&#xE74D;" FontSize="14" />
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
                <Grid Grid.Row="3" Margin="8,8,8,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" HorizontalAlignment="Center">
                        <Border Background="{StaticResource PanelAltBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                                CornerRadius="12" Padding="3">
                            <StackPanel x:Name="LayoutTabs" Orientation="Horizontal" Spacing="2" />
                        </Border>
                    </ScrollViewer>
                    <Grid Grid.Row="1">
                    <controls:ControllerDiagram x:Name="Diagram" Margin="8,4,8,28" />
                    <Border x:Name="HoverCard" Margin="0,0,0,8" VerticalAlignment="Bottom" HorizontalAlignment="Center"
                            Background="{StaticResource PanelAltBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                            CornerRadius="12" Padding="14,8" Opacity="0">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock x:Name="HoverName" FontWeight="SemiBold" FontSize="13" />
                            <Rectangle Width="1" Height="14" Fill="{StaticResource LineBrush}" VerticalAlignment="Center" />
                            <TextBlock x:Name="HoverBinding" FontSize="13" Foreground="{StaticResource AccentTextBrush}" />
                        </StackPanel>
                    </Border>
                    <TextBlock x:Name="HintText" Margin="0,0,0,10" VerticalAlignment="Bottom" HorizontalAlignment="Center"
                               Style="{StaticResource CaptionText}" Text="Click a control to edit it. Press it on the controller to see it light up." />
                    </Grid>
                </Grid>
            </Grid>
        </Border>

        <Border Grid.Column="1" Style="{StaticResource CardStyle}" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel Padding="18,16,18,0" Spacing="10">
                    <StackPanel Spacing="2">
                        <TextBlock Text="LAYOUT BINDINGS" Style="{StaticResource EyebrowText}" />
                        <TextBlock x:Name="BindingTitle" FontFamily="{StaticResource DisplayFont}" FontSize="22" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="ApplyBindingsButton" Content="Apply" Style="{StaticResource PrimaryButtonStyle}"
                                Click="OnApplyBindings" IsEnabled="False"
                                ToolTipService.ToolTip="Use these mappings on this controller. Other profiles keep the saved layout." />
                        <Button x:Name="SaveBindingsButton" Content="Save Changes" Style="{StaticResource QuietButtonStyle}"
                                Click="OnSaveBindings" IsEnabled="False"
                                ToolTipService.ToolTip="Write this layout so every profile that uses it gets the change." />
                    </StackPanel>
                    <StackPanel x:Name="BindingAlert" Orientation="Horizontal" Spacing="8" Visibility="Collapsed">
                        <FontIcon Glyph="&#xE7BA;" FontSize="12" Foreground="{StaticResource AmberBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="Changes have not been applied." FontSize="12" Foreground="{StaticResource AmberBrush}" VerticalAlignment="Center" TextWrapping="Wrap" />
                    </StackPanel>
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                        <Border Background="{StaticResource PanelAltBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                                CornerRadius="12" Padding="3" HorizontalAlignment="Left">
                            <StackPanel x:Name="SectionTabs" Orientation="Horizontal" Spacing="2" />
                        </Border>
                    </ScrollViewer>
                    <VariableSizedWrapGrid x:Name="ControlChips" Orientation="Horizontal" ItemHeight="36" ItemWidth="132" />
                </StackPanel>
                <Grid x:Name="BindingBody" Grid.Row="1">
                    <Grid.RowDefinitions>
                        <RowDefinition x:Name="ExtraRow" Height="0" />
                        <RowDefinition x:Name="EditorRow" Height="*" />
                    </Grid.RowDefinitions>
                    <ScrollViewer x:Name="ButtonListScroll" Padding="18,0,6,8" VerticalAlignment="Stretch" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                        <StackPanel x:Name="ButtonList" Spacing="4" Margin="0,0,16,0" />
                    </ScrollViewer>
                    <ScrollViewer x:Name="SectionScroll" Padding="18,8,18,0" VerticalScrollBarVisibility="Auto">
                        <Grid>
                            <StackPanel x:Name="StickSection" Spacing="16" Visibility="Collapsed" />
                            <StackPanel x:Name="TouchSection" Spacing="12" Visibility="Collapsed" />
                        </Grid>
                    </ScrollViewer>
                    <controls:BindingPanel x:Name="Editor" Grid.Row="1" />
                    <ScrollViewer x:Name="ButtonEditorScroll" Grid.Row="1" MaxHeight="220" VerticalAlignment="Top" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                        <controls:ButtonBinder x:Name="ButtonEditor" />
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
