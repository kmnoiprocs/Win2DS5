<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Win2DS5.App.Views.KeyboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="LegendKey" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource ButtonFillBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="MinWidth" Value="64" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="10,0" />
        </Style>
        <Style x:Key="LegendKeyText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource AccentTextBrush}" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="LegendText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        </Style>
    </UserControl.Resources>
    <ScrollViewer Padding="0,0,14,0">
        <StackPanel Spacing="14" Margin="0,0,0,16">
            <StackPanel Spacing="4">
                <TextBlock Text="OVERLAY" Style="{StaticResource EyebrowText}" />
                <TextBlock Text="On-screen keyboard" Style="{StaticResource TitleText}" />
                <TextBlock Style="{StaticResource CaptionText}" MaxWidth="720" HorizontalAlignment="Left"
                           Text="The keyboard never takes focus. Keys go to the app that was already in front. It opens beside the pointer, on whichever monitor the pointer is on. Create opens and closes it in the default profile, and Close on the keyboard dismisses it with the mouse. The keys follow a 65% keyboard, with suggestions on their own bar above the top row." />
            </StackPanel>
            <Grid ColumnSpacing="14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MaxWidth="460" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource CardStyle}" VerticalAlignment="Top">
                    <StackPanel Spacing="14">
                        <TextBlock Text="Window" Style="{StaticResource SectionText}" />
                        <Button x:Name="ShowButton" Content="Show keyboard" Style="{StaticResource PrimaryButtonStyle}" Click="OnShow" />
                        <StackPanel Spacing="2">
                            <Grid>
                                <TextBlock Text="Opacity" />
                                <TextBlock x:Name="OpacityLabel" HorizontalAlignment="Right" Foreground="{StaticResource AccentTextBrush}" />
                            </Grid>
                            <Slider x:Name="OpacitySlider" Minimum="0.28" Maximum="1" StepFrequency="0.02" ValueChanged="OnChanged" />
                        </StackPanel>
                        <StackPanel Spacing="2">
                            <Grid>
                                <TextBlock Text="Width" />
                                <TextBlock x:Name="WidthLabel" HorizontalAlignment="Right" Foreground="{StaticResource AccentTextBrush}" />
                            </Grid>
                            <Slider x:Name="WidthSlider" Minimum="760" Maximum="1800" ValueChanged="OnChanged" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource CaptionText}"
                                   Text="The right stick moves the keyboard across monitors. Hold L2 and use the right stick to resize it. Hold R2 and use the right stick to change opacity." />
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource CardStyle}" VerticalAlignment="Top">
                    <StackPanel Spacing="12">
                        <TextBlock Text="While it is open" Style="{StaticResource SectionText}" />
                        <Grid ColumnSpacing="14" RowSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition />
                                <RowDefinition />
                                <RowDefinition />
                                <RowDefinition />
                                <RowDefinition />
                                <RowDefinition />
                                <RowDefinition />
                                <RowDefinition />
                                <RowDefinition />
                            </Grid.RowDefinitions>
                            <Border Style="{StaticResource LegendKey}"><TextBlock Text="D-pad · L" Style="{StaticResource LegendKeyText}" /></Border>
                            <TextBlock Grid.Column="1" Text="Move across the keys. Up from the numbers reaches suggestions." Style="{StaticResource LegendText}" />
                            <Border Grid.Row="1" Style="{StaticResource LegendKey}"><TextBlock Text="✕" Style="{StaticResource LegendKeyText}" /></Border>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="Type the highlighted key" Style="{StaticResource LegendText}" />
                            <Border Grid.Row="2" Style="{StaticResource LegendKey}"><TextBlock Text="○" Style="{StaticResource LegendKeyText}" /></Border>
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="Backspace. Undoes an inserted suggestion." Style="{StaticResource LegendText}" />
                            <Border Grid.Row="3" Style="{StaticResource LegendKey}"><TextBlock Text="□" Style="{StaticResource LegendKeyText}" /></Border>
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="Space, keeping exactly what you spelled" Style="{StaticResource LegendText}" />
                            <Border Grid.Row="4" Style="{StaticResource LegendKey}"><TextBlock Text="△" Style="{StaticResource LegendKeyText}" /></Border>
                            <TextBlock Grid.Row="4" Grid.Column="1" Text="Enter" Style="{StaticResource LegendText}" />
                            <Border Grid.Row="5" Style="{StaticResource LegendKey}"><TextBlock Text="L1" Style="{StaticResource LegendKeyText}" /></Border>
                            <TextBlock Grid.Row="5" Grid.Column="1" Text="Next suggestion, from any key" Style="{StaticResource LegendText}" />
                            <Border Grid.Row="6" Style="{StaticResource LegendKey}"><TextBlock Text="R1" Style="{StaticResource LegendKeyText}" /></Border>
                            <TextBlock Grid.Row="6" Grid.Column="1" Text="Insert the highlighted suggestion" Style="{StaticResource LegendText}" />
                            <Border Grid.Row="7" Style="{StaticResource LegendKey}"><TextBlock Text="Touch" Style="{StaticResource LegendKeyText}" /></Border>
                            <TextBlock Grid.Row="7" Grid.Column="1" Text="Press the key under your finger, or a suggestion along the top" Style="{StaticResource LegendText}" />
                            <Border Grid.Row="8" Style="{StaticResource LegendKey}"><TextBlock Text="R stick" Style="{StaticResource LegendKeyText}" /></Border>
                            <TextBlock Grid.Row="8" Grid.Column="1" Text="Move across monitors · L2 resize · R2 opacity" Style="{StaticResource LegendText}" />
                        </Grid>
                        <TextBlock Style="{StaticResource CaptionText}" TextWrapping="Wrap"
                                   Text="Suggestions correct the word you are typing, finish it, or guess the next one from the word before it. R1 inserts the highlighted suggestion without moving the cursor. Words you accept or finish with space are remembered on this PC, together with the word that came before them. Fn turns the number row into F1 through F12. Shift, Ctrl, Alt, and Win light up and apply to the next key. Tap Win again to press it on its own." />
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
