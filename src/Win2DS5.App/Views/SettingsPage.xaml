<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Win2DS5.App.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer Padding="0,0,14,0">
        <StackPanel Spacing="14" Margin="0,0,0,16" MaxWidth="880" HorizontalAlignment="Left">
            <StackPanel Spacing="4">
                <TextBlock Text="PREFERENCES" Style="{StaticResource EyebrowText}" />
                <TextBlock Text="Settings" Style="{StaticResource TitleText}" />
            </StackPanel>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="16">
                    <Grid>
                        <StackPanel Spacing="4">
                            <TextBlock Text="Appearance" Style="{StaticResource SectionText}" />
                            <TextBlock Style="{StaticResource CaptionText}" Text="Pick a mode and an accent. The accent also colors the controller's light bar while desktop control is on." />
                        </StackPanel>
                    </Grid>
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                            <FontIcon x:Name="ModeGlyph" Glyph="&#xE708;" FontSize="16" Foreground="{StaticResource AccentTextBrush}" />
                            <TextBlock Text="Dark mode" VerticalAlignment="Center" />
                        </StackPanel>
                        <ToggleSwitch x:Name="DarkToggle" Grid.Column="1" OnContent="" OffContent="" MinWidth="0" Toggled="OnDarkToggled" />
                    </Grid>
                    <Rectangle Height="1" Fill="{StaticResource LineBrush}" />
                    <StackPanel Spacing="10">
                        <TextBlock Text="Accent color" />
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <StackPanel x:Name="Swatches" Orientation="Horizontal" Spacing="10" />
                            <Button x:Name="CustomButton" Style="{StaticResource QuietButtonStyle}" CornerRadius="17" Padding="12,7" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE790;" FontSize="13" />
                                    <TextBlock Text="Custom" />
                                </StackPanel>
                                <Button.Flyout>
                                    <Flyout x:Name="CustomFlyout" Placement="Bottom">
                                        <StackPanel Spacing="12" Width="300">
                                            <ColorPicker x:Name="Picker" IsAlphaEnabled="False" IsMoreButtonVisible="False"
                                                         IsColorSliderVisible="True" IsColorChannelTextInputVisible="False"
                                                         IsHexInputVisible="True" ColorSpectrumShape="Ring" />
                                            <Button Content="Use this color" Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Stretch" Click="OnUseCustom" />
                                        </StackPanel>
                                    </Flyout>
                                </Button.Flyout>
                            </Button>
                        </StackPanel>
                        <TextBlock x:Name="AccentName" Style="{StaticResource CaptionText}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="14">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Game handoff" Style="{StaticResource SectionText}" />
                        <TextBlock Style="{StaticResource CaptionText}"
                                   Text="Desktop mode asks HidHide to hide the real DualSense from other programs for this session only. Turning desktop mode off gives the real controller back, including haptics and adaptive triggers. That handoff takes about a second." />
                    </StackPanel>
                    <Border Style="{StaticResource InsetStyle}">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid Width="9" Height="9" VerticalAlignment="Center">
                                <Grid x:Name="HideGlow" />
                                <Ellipse x:Name="HideDot" Fill="{StaticResource SuccessBrush}" />
                            </Grid>
                            <TextBlock x:Name="HideStatus" Grid.Column="1" TextWrapping="Wrap" VerticalAlignment="Center" />
                            <HyperlinkButton x:Name="HideLink" Grid.Column="2" Content="Download HidHide" NavigateUri="https://github.com/nefarius/HidHide/releases" />
                        </Grid>
                    </Border>
                    <TextBlock x:Name="VirtualStatus" Style="{StaticResource CaptionText}" TextWrapping="Wrap" Visibility="Collapsed" />
                    <HyperlinkButton x:Name="VirtualLink" Content="Download ViGEmBus" NavigateUri="https://github.com/nefarius/ViGEmBus/releases" Visibility="Collapsed" HorizontalAlignment="Left" />
                    <Rectangle Height="1" Fill="{StaticResource LineBrush}" />
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="4" VerticalAlignment="Center">
                            <TextBlock Text="Administrator games" />
                            <TextBlock x:Name="AdminCaption" Style="{StaticResource CaptionText}" TextWrapping="Wrap" />
                        </StackPanel>
                        <Button x:Name="AdminButton" Grid.Column="1" Content="Restart as administrator" VerticalAlignment="Center"
                                Style="{StaticResource PrimaryButtonStyle}" Click="OnRestartAdmin" />
                    </Grid>
                    <Grid>
                        <StackPanel Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="Start with Windows" />
                            <TextBlock Style="{StaticResource CaptionText}" Text="Starts quietly in the tray." />
                        </StackPanel>
                        <ToggleSwitch x:Name="StartupToggle" HorizontalAlignment="Right" OnContent="" OffContent="" MinWidth="0" Toggled="OnStartup" />
                    </Grid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="12">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Updates" Style="{StaticResource SectionText}" />
                        <TextBlock x:Name="VersionText" Style="{StaticResource CaptionText}" />
                    </StackPanel>
                    <TextBlock x:Name="UpdateStatus" TextWrapping="Wrap" />
                    <Grid x:Name="UpdateAuto">
                        <StackPanel Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="Install published builds automatically" />
                            <TextBlock Style="{StaticResource CaptionText}" TextWrapping="Wrap"
                                       Text="Win2DS5 looks for a published build before it opens. A download found while this window is already open waits until you restart." />
                        </StackPanel>
                        <ToggleSwitch x:Name="UpdateToggle" HorizontalAlignment="Right" OnContent="" OffContent="" MinWidth="0" Toggled="OnUpdates" />
                    </Grid>
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Button x:Name="CheckUpdateButton" Content="Check now" Style="{StaticResource QuietButtonStyle}" Click="OnCheckUpdates" />
                        <Button x:Name="RestartUpdateButton" Content="Restart and update" Style="{StaticResource PrimaryButtonStyle}"
                                Visibility="Collapsed" Click="OnRestartUpdate" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="12">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="4" VerticalAlignment="Center">
                            <TextBlock Text="Reset Win2DS5" Style="{StaticResource SectionText}" />
                            <TextBlock Style="{StaticResource CaptionText}" TextWrapping="Wrap"
                                       Text="Deletes every profile, layout, and setting on this PC, including shell images, then restores DS4, XBOX, Touchpad, Sticks, and the default appearance." />
                        </StackPanel>
                        <Button Content="Reset app" Grid.Column="1" VerticalAlignment="Center"
                                Style="{StaticResource QuietButtonStyle}" Click="OnReset" />
                    </Grid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="12">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Long press" Style="{StaticResource SectionText}" />
                        <TextBlock Style="{StaticResource CaptionText}" TextWrapping="Wrap"
                                   Text="A button with a long-press command waits until you release it. A quicker release runs the tap. Holding it longer runs the long-press command. This time applies to every button unless that button overrides it." />
                    </StackPanel>
                    <Grid>
                        <TextBlock Text="Tap window" VerticalAlignment="Center" />
                        <TextBlock x:Name="LongPressValue" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{StaticResource AccentTextBrush}" />
                    </Grid>
                    <Slider x:Name="LongPressSlider" Minimum="100" Maximum="1000" StepFrequency="10" ValueChanged="OnLongPressDelay" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="14">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Enable chord" Style="{StaticResource SectionText}" />
                        <TextBlock Style="{StaticResource CaptionText}"
                                   Text="Hold every checked control together to turn desktop control on or off. The tray icon is always another way out. Pick at least two." />
                    </StackPanel>
                    <VariableSizedWrapGrid x:Name="ChordList" Orientation="Horizontal" ItemWidth="150" ItemHeight="36" />
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Button Content="Save chord" Style="{StaticResource PrimaryButtonStyle}" Click="OnSaveChord" />
                        <TextBlock x:Name="ChordWarning" Foreground="{StaticResource AmberBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="10">
                    <TextBlock Text="Other software" Style="{StaticResource SectionText}" />
                    <TextBlock x:Name="SteamWarning" TextWrapping="Wrap" Foreground="{StaticResource AmberBrush}" />
                    <TextBlock x:Name="GameBarWarning" TextWrapping="Wrap" Foreground="{StaticResource AmberBrush}" />
                    <TextBlock Style="{StaticResource CaptionText}"
                               Text="Steam Input and the XBOX Game Bar can also grab a DualSense. Turn those off for the controller while you use it as a mouse. Closing this window leaves Win2DS5 running in the tray." />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
