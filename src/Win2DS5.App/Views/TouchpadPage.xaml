<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Win2DS5.App.Views.TouchpadPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Win2DS5.App.Controls">
    <UserControl.Resources>
        <Style x:Key="ValueText" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource AccentTextBrush}" />
        </Style>
        <Style x:Key="FieldText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        </Style>
    </UserControl.Resources>
    <ScrollViewer Padding="0,0,14,0">
        <StackPanel Spacing="14" Margin="0,0,0,16">
            <StackPanel Spacing="4">
                <TextBlock Text="POINTER" Style="{StaticResource EyebrowText}" />
                <TextBlock Text="Touchpad and sticks" Style="{StaticResource TitleText}" />
            </StackPanel>

            <Grid ColumnSpacing="14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="420" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="14">
                        <TextBlock Text="Touchpad" Style="{StaticResource SectionText}" />
                        <controls:ZoneEditor x:Name="Zones" />
                        <TextBlock Style="{StaticResource CaptionText}" Text="Click a zone to edit its actions. Drag the glowing splits to resize zones. The top strip wins where it overlaps a side." />
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Pointer mode" Style="{StaticResource FieldText}" VerticalAlignment="Center" />
                            <ComboBox x:Name="ModeBox" Grid.Column="1" MinWidth="150" CornerRadius="9" SelectionChanged="OnChanged" />
                        </Grid>
                        <StackPanel>
                            <Grid>
                                <TextBlock x:Name="SensitivityLabel" Style="{StaticResource FieldText}" />
                                <TextBlock x:Name="SensitivityValue" Style="{StaticResource ValueText}" />
                            </Grid>
                            <Slider x:Name="Sensitivity" Minimum="0.4" Maximum="3" StepFrequency="0.05" ValueChanged="OnChanged" />
                        </StackPanel>
                        <StackPanel Spacing="8">
                            <TextBlock Text="Response curve" Style="{StaticResource FieldText}" />
                            <controls:CurveEditor x:Name="Curve" />
                        </StackPanel>
                        <StackPanel>
                            <Grid>
                                <TextBlock Text="Long press" Style="{StaticResource FieldText}" />
                                <TextBlock x:Name="LongPressValue" Style="{StaticResource ValueText}" />
                            </Grid>
                            <Slider x:Name="LongPress" Minimum="200" Maximum="800" StepFrequency="10" ValueChanged="OnChanged" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="20">
                            <CheckBox x:Name="TwoFinger" Content="Two-finger scroll" Checked="OnChanged" Unchecked="OnChanged" />
                            <CheckBox x:Name="EdgeScroll" Content="Edge scroll" Checked="OnChanged" Unchecked="OnChanged" />
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource CardStyle}" Padding="0" VerticalAlignment="Stretch">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <StackPanel Padding="18,18,18,4" Spacing="10">
                            <TextBlock Text="Zone actions" Style="{StaticResource SectionText}" />
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <ComboBox x:Name="ZoneBox" Header="Zone" HorizontalAlignment="Stretch" CornerRadius="9" SelectionChanged="OnGestureTargetChanged" />
                                <ComboBox x:Name="GestureBox" Grid.Column="1" Header="Gesture" HorizontalAlignment="Stretch" CornerRadius="9" SelectionChanged="OnGestureTargetChanged" />
                            </Grid>
                        </StackPanel>
                        <controls:BindingPanel x:Name="GestureEditor" Grid.Row="1" />
                    </Grid>
                </Border>
            </Grid>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="14">
                    <TextBlock Text="Sticks" Style="{StaticResource SectionText}" />
                    <Grid ColumnSpacing="28">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="1" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="10">
                            <Grid>
                                <TextBlock Text="LEFT STICK" Style="{StaticResource EyebrowText}" VerticalAlignment="Center" />
                                <ComboBox x:Name="LeftMode" HorizontalAlignment="Right" MinWidth="130" CornerRadius="9" SelectionChanged="OnChanged" />
                            </Grid>
                            <StackPanel>
                                <Grid>
                                    <TextBlock Text="Speed" Style="{StaticResource FieldText}" />
                                    <TextBlock x:Name="LeftSensitivityValue" Style="{StaticResource ValueText}" />
                                </Grid>
                                <Slider x:Name="LeftSensitivity" Minimum="200" Maximum="4000" ValueChanged="OnChanged" />
                            </StackPanel>
                            <StackPanel>
                                <Grid>
                                    <TextBlock Text="Deadzone" Style="{StaticResource FieldText}" />
                                    <TextBlock x:Name="LeftDeadzoneValue" Style="{StaticResource ValueText}" />
                                </Grid>
                                <Slider x:Name="LeftDeadzone" Minimum="0" Maximum="0.4" StepFrequency="0.01" ValueChanged="OnChanged" />
                            </StackPanel>
                            <StackPanel>
                                <Grid>
                                    <TextBlock Text="Curve" Style="{StaticResource FieldText}" />
                                    <TextBlock x:Name="LeftCurveValue" Style="{StaticResource ValueText}" />
                                </Grid>
                                <Slider x:Name="LeftCurve" Minimum="0.6" Maximum="3" StepFrequency="0.05" ValueChanged="OnChanged" />
                            </StackPanel>
                        </StackPanel>
                        <Rectangle Grid.Column="1" Fill="{StaticResource LineBrush}" />
                        <StackPanel Grid.Column="2" Spacing="10">
                            <Grid>
                                <TextBlock Text="RIGHT STICK" Style="{StaticResource EyebrowText}" VerticalAlignment="Center" />
                                <ComboBox x:Name="RightMode" HorizontalAlignment="Right" MinWidth="130" CornerRadius="9" SelectionChanged="OnChanged" />
                            </Grid>
                            <StackPanel>
                                <Grid>
                                    <TextBlock Text="Speed" Style="{StaticResource FieldText}" />
                                    <TextBlock x:Name="RightSensitivityValue" Style="{StaticResource ValueText}" />
                                </Grid>
                                <Slider x:Name="RightSensitivity" Minimum="200" Maximum="4000" ValueChanged="OnChanged" />
                            </StackPanel>
                            <StackPanel>
                                <Grid>
                                    <TextBlock Text="Deadzone" Style="{StaticResource FieldText}" />
                                    <TextBlock x:Name="RightDeadzoneValue" Style="{StaticResource ValueText}" />
                                </Grid>
                                <Slider x:Name="RightDeadzone" Minimum="0" Maximum="0.4" StepFrequency="0.01" ValueChanged="OnChanged" />
                            </StackPanel>
                            <StackPanel>
                                <Grid>
                                    <TextBlock Text="Curve" Style="{StaticResource FieldText}" />
                                    <TextBlock x:Name="RightCurveValue" Style="{StaticResource ValueText}" />
                                </Grid>
                                <Slider x:Name="RightCurve" Minimum="0.6" Maximum="3" StepFrequency="0.05" ValueChanged="OnChanged" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="14">
                    <Grid>
                        <StackPanel Spacing="4">
                            <TextBlock Text="Gyro" Style="{StaticResource SectionText}" />
                            <TextBlock Style="{StaticResource CaptionText}" Text="Off until you turn it on. Hold the activator and aim with the controller." />
                        </StackPanel>
                        <CheckBox x:Name="GyroEnabled" Content="Gyro mouse" HorizontalAlignment="Right" VerticalAlignment="Top" Checked="OnChanged" Unchecked="OnChanged" />
                    </Grid>
                    <Grid ColumnSpacing="28">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="10">
                            <ComboBox x:Name="GyroActivator" Header="Activator" HorizontalAlignment="Stretch" CornerRadius="9" SelectionChanged="OnChanged" />
                            <StackPanel Orientation="Horizontal" Spacing="20">
                                <CheckBox x:Name="InvertX" Content="Invert X" Checked="OnChanged" Unchecked="OnChanged" />
                                <CheckBox x:Name="InvertY" Content="Invert Y" Checked="OnChanged" Unchecked="OnChanged" />
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <Grid>
                                <TextBlock Text="Sensitivity" Style="{StaticResource FieldText}" />
                                <TextBlock x:Name="GyroSensitivityValue" Style="{StaticResource ValueText}" />
                            </Grid>
                            <Slider x:Name="GyroSensitivity" Minimum="2" Maximum="80" ValueChanged="OnChanged" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
