<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Win2DS5.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:Win2DS5.App.Views"
    Title="Win2DS5">
    <Grid x:Name="Root" Background="{StaticResource CanvasGradientBrush}">
        <Grid.Resources>
            <Storyboard x:Name="PulseStory" RepeatBehavior="Forever">
                <DoubleAnimation Storyboard.TargetName="PulseScale" Storyboard.TargetProperty="ScaleX" From="1" To="2.6" Duration="0:0:1.6">
                    <DoubleAnimation.EasingFunction>
                        <CubicEase EasingMode="EaseOut" />
                    </DoubleAnimation.EasingFunction>
                </DoubleAnimation>
                <DoubleAnimation Storyboard.TargetName="PulseScale" Storyboard.TargetProperty="ScaleY" From="1" To="2.6" Duration="0:0:1.6">
                    <DoubleAnimation.EasingFunction>
                        <CubicEase EasingMode="EaseOut" />
                    </DoubleAnimation.EasingFunction>
                </DoubleAnimation>
                <DoubleAnimation Storyboard.TargetName="PulseRing" Storyboard.TargetProperty="Opacity" From="0.7" To="0" Duration="0:0:1.6" />
            </Storyboard>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="56" />
            <RowDefinition Height="*" />
            <RowDefinition Height="38" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid>
            <Rectangle Fill="{StaticResource HeaderGradientBrush}" />
            <Rectangle Height="1" VerticalAlignment="Bottom" Fill="{StaticResource LineBrush}" />
            <Rectangle Height="1" Width="420" HorizontalAlignment="Left" VerticalAlignment="Bottom" Fill="{StaticResource GlowLineBrush}" />
            <Grid Padding="18,0,0,0" ColumnSpacing="14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="150" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <Grid Width="30" Height="30">
                        <Grid x:Name="LogoGlow" />
                        <Rectangle x:Name="LogoMark" RadiusX="9" RadiusY="9" Fill="{StaticResource AccentGradientBrush}" />
                        <FontIcon Glyph="&#xE7FC;" FontSize="15" Foreground="{StaticResource AccentInkBrush}" />
                    </Grid>
                    <StackPanel VerticalAlignment="Center" Spacing="0">
                        <TextBlock Text="Win2DS5" FontFamily="{StaticResource DisplayFont}" FontSize="15" FontWeight="SemiBold" />
                        <TextBlock Text="DualSense desktop studio" FontSize="11" Foreground="{StaticResource MutedBrush}" />
                    </StackPanel>
                </StackPanel>
                <Button x:Name="ModeChip" Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center" Click="OnModeChip"
                        Style="{StaticResource QuietButtonStyle}" CornerRadius="15" Padding="12,5"
                        Background="{StaticResource AccentSoftBrush}" BorderBrush="{StaticResource AccentHaloBrush}">
                    <StackPanel Orientation="Horizontal" Spacing="9">
                        <Grid Width="8" Height="8" VerticalAlignment="Center">
                            <Ellipse x:Name="PulseRing" Fill="{StaticResource AccentBrush}" Opacity="0" RenderTransformOrigin="0.5,0.5">
                                <Ellipse.RenderTransform>
                                    <ScaleTransform x:Name="PulseScale" />
                                </Ellipse.RenderTransform>
                            </Ellipse>
                            <Ellipse x:Name="ModeDot" Fill="{StaticResource AccentBrush}" />
                        </Grid>
                        <TextBlock x:Name="ModeCaption" Text="Desktop control" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource AccentTextBrush}" />
                    </StackPanel>
                </Button>
                <Grid x:Name="DragRegion" Grid.Column="2" Background="Transparent" />
                <Button x:Name="ThemeButton" Grid.Column="3" Style="{StaticResource GhostButtonStyle}" VerticalAlignment="Center"
                        Click="OnThemeButton" Padding="9" CornerRadius="10">
                    <FontIcon x:Name="ThemeGlyph" Glyph="&#xE708;" FontSize="15" />
                </Button>
            </Grid>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="216" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Rail -->
            <Border Background="{StaticResource RailGradientBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,1,0">
                <Grid Padding="12,18,12,14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="STUDIO" Margin="14,0,0,10" Style="{StaticResource EyebrowText}" Foreground="{StaticResource MutedBrush}" />
                    <Grid Grid.Row="1">
                        <Grid x:Name="RailIndicator" Height="42" VerticalAlignment="Top">
                            <Border CornerRadius="10" Background="{StaticResource SelectedRailBrush}" />
                            <Grid Width="3" Height="20" HorizontalAlignment="Left" Margin="1,0,0,0">
                                <Grid x:Name="RailBarGlow" />
                                <Rectangle x:Name="RailBar" RadiusX="1.5" RadiusY="1.5" Fill="{StaticResource AccentBrush}" />
                            </Grid>
                        </Grid>
                        <StackPanel x:Name="Rail" Spacing="4" />
                    </Grid>
                    <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="14" CornerRadius="12">
                        <StackPanel Spacing="10">
                            <Grid>
                                <StackPanel>
                                    <TextBlock Text="CONTROLLER" Style="{StaticResource EyebrowText}" Foreground="{StaticResource MutedBrush}" />
                                    <TextBlock x:Name="DeviceName" Text="DualSense" Margin="0,4,0,0" FontWeight="SemiBold" FontSize="13" />
                                </StackPanel>
                                <FontIcon x:Name="LinkGlyph" Glyph="&#xE839;" FontSize="14" HorizontalAlignment="Right" VerticalAlignment="Top" Foreground="{StaticResource MutedBrush}" />
                            </Grid>
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid x:Name="BatteryTrack" Height="6" VerticalAlignment="Center">
                                    <Border CornerRadius="3" Background="{StaticResource PanelAltBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" />
                                    <Grid x:Name="BatteryFill" HorizontalAlignment="Left" Width="0">
                                        <Grid x:Name="BatteryGlow" />
                                        <Rectangle x:Name="BatteryBar" RadiusX="3" RadiusY="3" Fill="{StaticResource AccentGradientBrush}" />
                                    </Grid>
                                </Grid>
                                <TextBlock x:Name="BatteryText" Grid.Column="1" Text="--" FontSize="11" Foreground="{StaticResource MutedBrush}" />
                            </Grid>
                            <TextBlock x:Name="ProfileName" FontSize="11" Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <Grid x:Name="Pages" Grid.Column="1" Margin="22,18,22,14">
                <views:ControlsPage x:Name="Controls" />
                <views:TouchpadPage x:Name="Touchpad" Visibility="Collapsed" />
                <views:KeyboardPage x:Name="Keyboard" Visibility="Collapsed" />
                <views:ProfilesPage x:Name="Profiles" Visibility="Collapsed" />
                <views:SettingsPage x:Name="Settings" Visibility="Collapsed" />
            </Grid>
        </Grid>

        <!-- Status bar -->
        <Grid Grid.Row="2" Padding="20,0" Background="{StaticResource RailBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <Grid Width="8" Height="8">
                    <Grid x:Name="StatusGlow" />
                    <Ellipse x:Name="StatusDot" Fill="{StaticResource SuccessBrush}" />
                </Grid>
                <TextBlock x:Name="StatusText" FontSize="12" Foreground="{StaticResource MutedBrush}" />
            </StackPanel>
            <StackPanel x:Name="NoticePanel" Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Opacity="0">
                <FontIcon Glyph="&#xE7BA;" FontSize="12" Foreground="{StaticResource AmberBrush}" />
                <TextBlock x:Name="NoticeText" FontSize="12" Foreground="{StaticResource AmberBrush}" VerticalAlignment="Center" />
                <Button x:Name="ElevateButton" Content="Restart as administrator" Style="{StaticResource QuietButtonStyle}"
                        Padding="10,4" FontSize="12" CornerRadius="12" VerticalAlignment="Center" Visibility="Collapsed"
                        Click="OnElevate" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
