<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="Win2DS5.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <FontFamily x:Key="UiFont">Segoe UI Variable Text, Segoe UI</FontFamily>
            <FontFamily x:Key="DisplayFont">Segoe UI Variable Display, Segoe UI</FontFamily>
            <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

            <!-- Colors are written by Theme.Apply at startup and whenever the appearance changes. -->
            <SolidColorBrush x:Key="CanvasBrush" Color="#0A0C10" />
            <SolidColorBrush x:Key="RailBrush" Color="#0E1116" />
            <SolidColorBrush x:Key="PanelBrush" Color="#13161C" />
            <SolidColorBrush x:Key="PanelAltBrush" Color="#1B1F28" />
            <SolidColorBrush x:Key="LineBrush" Color="#262B35" />
            <SolidColorBrush x:Key="TextBrush" Color="#F2F4F8" />
            <SolidColorBrush x:Key="MutedBrush" Color="#8E97A8" />
            <SolidColorBrush x:Key="AmberBrush" Color="#F5B853" />
            <SolidColorBrush x:Key="AmberHaloBrush" Color="#66F5B853" />
            <SolidColorBrush x:Key="SuccessBrush" Color="#4ADE80" />
            <SolidColorBrush x:Key="SuccessHaloBrush" Color="#554ADE80" />
            <SolidColorBrush x:Key="HoverBrush" Color="#16FFFFFF" />
            <SolidColorBrush x:Key="PadPlateBrush" Color="#0D1015" />
            <SolidColorBrush x:Key="PadEdgeBrush" Color="#2F3542" />
            <SolidColorBrush x:Key="PadKeyLineBrush" Color="#3A4250" />
            <SolidColorBrush x:Key="PadInkBrush" Color="#D7DDE8" />
            <SolidColorBrush x:Key="PlateKeyLineBrush" Color="#353C49" />
            <SolidColorBrush x:Key="PlateInkBrush" Color="#C3CAD6" />
            <SolidColorBrush x:Key="TouchSurfaceBrush" Color="#1B2028" />
            <SolidColorBrush x:Key="WellBrush" Color="#090B0F" />

            <SolidColorBrush x:Key="AccentBrush" Color="#7EB6FF" />
            <SolidColorBrush x:Key="AccentHoverBrush" Color="#98C6FF" />
            <SolidColorBrush x:Key="AccentPressedBrush" Color="#6795D1" />
            <SolidColorBrush x:Key="AccentInkBrush" Color="#0A0C10" />
            <SolidColorBrush x:Key="AccentTextBrush" Color="#7EB6FF" />
            <SolidColorBrush x:Key="AccentSoftBrush" Color="#2E7EB6FF" />
            <SolidColorBrush x:Key="AccentHaloBrush" Color="#6A7EB6FF" />

            <LinearGradientBrush x:Key="CanvasGradientBrush" StartPoint="0,0" EndPoint="0.4,1">
                <GradientStop Offset="0" Color="#11141B" />
                <GradientStop Offset="1" Color="#0A0C10" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="PanelGradientBrush" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Offset="0" Color="#1A1E26" />
                <GradientStop Offset="1" Color="#13161C" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="RailGradientBrush" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Offset="0" Color="#0E1116" />
                <GradientStop Offset="1" Color="#0A0C10" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="ButtonFillBrush" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Offset="0" Color="#232833" />
                <GradientStop Offset="1" Color="#1B1F28" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="PadShellBrush" StartPoint="0.5,0" EndPoint="0.5,1">
                <GradientStop Offset="0" Color="#262B35" />
                <GradientStop Offset="1" Color="#161A21" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="PadKeyBrush" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Offset="0" Color="#252A34" />
                <GradientStop Offset="1" Color="#13161C" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="PlateKeyBrush" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Offset="0" Color="#20252E" />
                <GradientStop Offset="1" Color="#0F1217" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="HeaderGradientBrush" StartPoint="0,0" EndPoint="1,0">
                <GradientStop Offset="0" Color="#2C7EB6FF" />
                <GradientStop Offset="0.6" Color="#007EB6FF" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="AccentGradientBrush" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Offset="0" Color="#98C6FF" />
                <GradientStop Offset="1" Color="#74A8EB" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="SelectedRailBrush" StartPoint="0,0" EndPoint="1,0">
                <GradientStop Offset="0" Color="#307EB6FF" />
                <GradientStop Offset="1" Color="#007EB6FF" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="GlowLineBrush" StartPoint="0,0" EndPoint="1,0">
                <GradientStop Offset="0" Color="#007EB6FF" />
                <GradientStop Offset="0.5" Color="#D07EB6FF" />
                <GradientStop Offset="1" Color="#007EB6FF" />
            </LinearGradientBrush>

            <!-- Point the built-in controls at the live accent brushes. -->
            <StaticResource x:Key="AccentFillColorDefaultBrush" ResourceKey="AccentBrush" />
            <StaticResource x:Key="AccentFillColorSecondaryBrush" ResourceKey="AccentHoverBrush" />
            <StaticResource x:Key="AccentFillColorTertiaryBrush" ResourceKey="AccentPressedBrush" />
            <StaticResource x:Key="AccentTextFillColorPrimaryBrush" ResourceKey="AccentTextBrush" />
            <StaticResource x:Key="AccentTextFillColorSecondaryBrush" ResourceKey="AccentTextBrush" />
            <StaticResource x:Key="AccentTextFillColorTertiaryBrush" ResourceKey="AccentTextBrush" />
            <StaticResource x:Key="TextOnAccentFillColorPrimaryBrush" ResourceKey="AccentInkBrush" />
            <StaticResource x:Key="SliderTrackValueFill" ResourceKey="AccentBrush" />
            <StaticResource x:Key="SliderTrackValueFillPointerOver" ResourceKey="AccentHoverBrush" />
            <StaticResource x:Key="SliderTrackValueFillPressed" ResourceKey="AccentPressedBrush" />
            <StaticResource x:Key="SliderThumbBackground" ResourceKey="AccentBrush" />
            <StaticResource x:Key="SliderThumbBackgroundPointerOver" ResourceKey="AccentHoverBrush" />
            <StaticResource x:Key="SliderThumbBackgroundPressed" ResourceKey="AccentPressedBrush" />
            <StaticResource x:Key="ToggleSwitchFillOn" ResourceKey="AccentBrush" />
            <StaticResource x:Key="ToggleSwitchFillOnPointerOver" ResourceKey="AccentHoverBrush" />
            <StaticResource x:Key="ToggleSwitchFillOnPressed" ResourceKey="AccentPressedBrush" />
            <StaticResource x:Key="ToggleSwitchStrokeOn" ResourceKey="AccentBrush" />
            <StaticResource x:Key="ToggleSwitchStrokeOnPointerOver" ResourceKey="AccentHoverBrush" />
            <StaticResource x:Key="ToggleSwitchStrokeOnPressed" ResourceKey="AccentPressedBrush" />
            <StaticResource x:Key="ToggleSwitchKnobFillOn" ResourceKey="AccentInkBrush" />
            <StaticResource x:Key="ToggleSwitchKnobFillOnPointerOver" ResourceKey="AccentInkBrush" />
            <StaticResource x:Key="ToggleSwitchKnobFillOnPressed" ResourceKey="AccentInkBrush" />
            <StaticResource x:Key="CheckBoxCheckBackgroundFillChecked" ResourceKey="AccentBrush" />
            <StaticResource x:Key="CheckBoxCheckBackgroundFillCheckedPointerOver" ResourceKey="AccentHoverBrush" />
            <StaticResource x:Key="CheckBoxCheckBackgroundFillCheckedPressed" ResourceKey="AccentPressedBrush" />
            <StaticResource x:Key="CheckBoxCheckBackgroundStrokeChecked" ResourceKey="AccentBrush" />
            <StaticResource x:Key="CheckBoxCheckBackgroundStrokeCheckedPointerOver" ResourceKey="AccentHoverBrush" />
            <StaticResource x:Key="CheckBoxCheckBackgroundStrokeCheckedPressed" ResourceKey="AccentPressedBrush" />
            <StaticResource x:Key="CheckBoxCheckGlyphForegroundChecked" ResourceKey="AccentInkBrush" />
            <StaticResource x:Key="CheckBoxCheckGlyphForegroundCheckedPointerOver" ResourceKey="AccentInkBrush" />
            <StaticResource x:Key="CheckBoxCheckGlyphForegroundCheckedPressed" ResourceKey="AccentInkBrush" />
            <StaticResource x:Key="ComboBoxItemPillFillBrush" ResourceKey="AccentBrush" />
            <StaticResource x:Key="ListViewItemSelectionIndicatorBrush" ResourceKey="AccentBrush" />
            <StaticResource x:Key="ListViewItemSelectionIndicatorPointerOverBrush" ResourceKey="AccentHoverBrush" />
            <StaticResource x:Key="ListViewItemSelectionIndicatorPressedBrush" ResourceKey="AccentPressedBrush" />
            <StaticResource x:Key="HyperlinkButtonForeground" ResourceKey="AccentTextBrush" />
            <StaticResource x:Key="HyperlinkButtonForegroundPointerOver" ResourceKey="AccentHoverBrush" />
            <StaticResource x:Key="TabViewSelectedItemHeaderForeground" ResourceKey="AccentTextBrush" />

            <Style x:Key="QuietButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="{StaticResource ButtonFillBrush}" />
                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Padding" Value="14,8" />
                <Setter Property="CornerRadius" Value="9" />
                <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="HorizontalAlignment" Value="Left" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="UseSystemFocusVisuals" Value="True" />
                <Setter Property="FocusVisualMargin" Value="-3" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid x:Name="Root" RenderTransformOrigin="0.5,0.5">
                                <Grid.RenderTransform>
                                    <ScaleTransform x:Name="Scale" />
                                </Grid.RenderTransform>
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualStateGroup.Transitions>
                                            <VisualTransition GeneratedDuration="0:0:0.16" />
                                            <VisualTransition To="Pressed" GeneratedDuration="0:0:0.06" />
                                        </VisualStateGroup.Transitions>
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver">
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="Halo" Storyboard.TargetProperty="Opacity" To="0.75" Duration="0" />
                                                <DoubleAnimation Storyboard.TargetName="Edge" Storyboard.TargetProperty="Opacity" To="0.6" Duration="0" />
                                                <DoubleAnimation Storyboard.TargetName="Sheen" Storyboard.TargetProperty="Opacity" To="1" Duration="0" />
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="Halo" Storyboard.TargetProperty="Opacity" To="1" Duration="0" />
                                                <DoubleAnimation Storyboard.TargetName="Edge" Storyboard.TargetProperty="Opacity" To="1" Duration="0" />
                                                <DoubleAnimation Storyboard.TargetName="Sheen" Storyboard.TargetProperty="Opacity" To="0.5" Duration="0" />
                                                <DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleX" To="0.96" Duration="0" />
                                                <DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleY" To="0.96" Duration="0" />
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="Disabled">
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="Opacity" To="0.4" Duration="0" />
                                            </Storyboard>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                                <Border x:Name="Halo" Margin="-4" Opacity="0" BorderThickness="4"
                                        BorderBrush="{StaticResource AccentSoftBrush}"
                                        CornerRadius="13" />
                                <Border x:Name="Body"
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="{TemplateBinding CornerRadius}" />
                                <Border x:Name="Sheen" Opacity="0" Background="{StaticResource HoverBrush}"
                                        CornerRadius="{TemplateBinding CornerRadius}" />
                                <Border x:Name="Edge" Opacity="0" BorderThickness="1"
                                        BorderBrush="{StaticResource AccentBrush}"
                                        CornerRadius="{TemplateBinding CornerRadius}" />
                                <ContentPresenter x:Name="ContentPresenter"
                                                  Margin="{TemplateBinding Padding}"
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                  Content="{TemplateBinding Content}"
                                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                                  Foreground="{TemplateBinding Foreground}"
                                                  FontFamily="{TemplateBinding FontFamily}"
                                                  FontSize="{TemplateBinding FontSize}"
                                                  FontWeight="{TemplateBinding FontWeight}" />
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource QuietButtonStyle}">
                <Setter Property="Background" Value="{StaticResource AccentGradientBrush}" />
                <Setter Property="Foreground" Value="{StaticResource AccentInkBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource AccentHoverBrush}" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>

            <Style x:Key="GhostButtonStyle" TargetType="Button" BasedOn="{StaticResource QuietButtonStyle}">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
                <Setter Property="Padding" Value="8,6" />
            </Style>

            <Style x:Key="RailButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="HorizontalContentAlignment" Value="Left" />
                <Setter Property="Height" Value="42" />
                <Setter Property="Padding" Value="14,0" />
                <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid x:Name="Root" Background="Transparent">
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualStateGroup.Transitions>
                                            <VisualTransition GeneratedDuration="0:0:0.14" />
                                        </VisualStateGroup.Transitions>
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver">
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="Wash" Storyboard.TargetProperty="Opacity" To="1" Duration="0" />
                                                <DoubleAnimation Storyboard.TargetName="Shift" Storyboard.TargetProperty="X" To="3" Duration="0" />
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="Wash" Storyboard.TargetProperty="Opacity" To="0.6" Duration="0" />
                                                <DoubleAnimation Storyboard.TargetName="Shift" Storyboard.TargetProperty="X" To="1" Duration="0" />
                                            </Storyboard>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                                <Border x:Name="Wash" Opacity="0" CornerRadius="10" Background="{StaticResource HoverBrush}" />
                                <ContentPresenter Margin="{TemplateBinding Padding}"
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="Center"
                                                  Content="{TemplateBinding Content}"
                                                  Foreground="{TemplateBinding Foreground}"
                                                  FontFamily="{TemplateBinding FontFamily}"
                                                  FontSize="{TemplateBinding FontSize}">
                                    <ContentPresenter.RenderTransform>
                                        <TranslateTransform x:Name="Shift" />
                                    </ContentPresenter.RenderTransform>
                                </ContentPresenter>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="CardStyle" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource PanelGradientBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="14" />
                <Setter Property="Padding" Value="18" />
            </Style>

            <Style x:Key="InsetStyle" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource PanelAltBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="Padding" Value="12" />
            </Style>

            <Style x:Key="ChipStyle" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource AccentSoftBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource AccentHaloBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="11" />
                <Setter Property="Padding" Value="10,3" />
            </Style>

            <Style TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            </Style>

            <Style x:Key="EyebrowText" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
                <Setter Property="FontSize" Value="11" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="CharacterSpacing" Value="140" />
                <Setter Property="Foreground" Value="{StaticResource AccentTextBrush}" />
            </Style>

            <Style x:Key="TitleText" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
                <Setter Property="FontSize" Value="24" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            </Style>

            <Style x:Key="SectionText" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
                <Setter Property="FontSize" Value="15" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            </Style>

            <Style x:Key="CaptionText" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
